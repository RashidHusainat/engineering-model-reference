#!/usr/bin/env sh
set -eu

ROOT=$(git rev-parse --show-toplevel)

if command -v pwsh >/dev/null 2>&1; then
  exec pwsh -NoProfile -File "$ROOT/eng/verify.ps1" -Profile PrePush
fi

if command -v powershell.exe >/dev/null 2>&1; then
  exec powershell.exe -NoProfile -File "$ROOT/eng/verify.ps1" -Profile PrePush
fi

printf '%s\n' "PowerShell is required for the shared verification entry point." >&2
exit 1
